# 复制为 修正版代码/.env 后按需修改（所有变量前缀 APP_）
# 后端会自动读取（pydantic-settings）。

# ---- 服务 ----
APP_PORT=8000
APP_HOST=0.0.0.0
APP_WORKERS=1
APP_LOG_LEVEL=info
# 前端域名白名单（逗号分隔）；开发期用 *
APP_CORS_ORIGINS=*

# ---- 模型 / 推理 ----
# 启动即加载权重（false=首次请求时懒加载）
APP_PRELOAD_MODEL=true
# 推理设备：auto | cpu | cuda | 0
APP_DEVICE=auto
# GPU 建议 1（串行化避免 OOM）；CPU 可调大
APP_INFERENCE_CONCURRENCY=1

# ---- 强制演示模式（纯 UI 演示部署，不加载模型）----
APP_FORCE_DEMO=false

# ---- 北斗 / GNSS 定位 ----
# 定位源：auto | serial | file | mock
#   auto   先扫串口，再试回放文件；都没有则进入 unavailable（不会静默编坐标）
#   serial 串口直读北斗模块（NMEA 0183）
#   file   回放 NMEA 日志（无硬件演示 / 复现问题）
#   mock   显式模拟（界面会标明"模拟"）
APP_GNSS_SOURCE=auto
# 串口名，留空则自动扫描（Windows 形如 COM3，Linux 形如 /dev/ttyUSB0）
APP_GNSS_PORT=
APP_GNSS_BAUD=9600
# 回放用的 NMEA 日志（GNSS_SOURCE=file 时必填）
APP_GNSS_FILE=
APP_GNSS_REPLAY_LOOP=true
APP_GNSS_REPLAY_SPEED=1.0
# 超过该秒数没有新定位即视为"数据过期"（界面会标灰）
APP_GNSS_STALE_S=5.0
# 超过该秒数彻底判为"无定位"
APP_GNSS_MAX_AGE_S=30.0

# 无硬件时的模拟坐标（仅 GNSS_SOURCE=mock 时使用）
APP_BEIDOU_LAT=28.169
APP_BEIDOU_LON=112.944
APP_BEIDOU_ALT=50.0
APP_BEIDOU_SATELLITES=12

# ---- 像素 → 地面距离（目标地理坐标换算）----
# 地面采样距离 GSD（米/像素）。0 = 未标定，此时不产出目标地理坐标。
# 正解：飞行高度 × 像元角，或用地面控制点标定。
APP_GEO_GSD_M_PER_PX=0
# 未标定时允许用估算值出"示意坐标"（结果会带 estimated 标记）
APP_GEO_ALLOW_ESTIMATE=true
APP_GEO_ESTIMATE_GSD=0.021

# ---- 切片推理（小目标）----
APP_SLICE_ENABLED=true
APP_SLICE_SIZE=640
APP_SLICE_OVERLAP=0.2
# builtin（自带零依赖） | sahi（若已安装）
APP_SLICE_ENGINE=builtin

# ---- 上传限制（MB）----
APP_MAX_UPLOAD_MB=50
APP_MAX_VIDEO_MB=500

# ---- 可选鉴权（默认关闭）----
APP_ENABLE_AUTH=false
APP_API_KEY=

# ---- 视频输出 ----
# 首选编码器：avc1(H.264，浏览器 <video> 可直接播放) | mp4v | XVID
# 后端会先试写小样回读校验；不可用则自动降级到候选表里的下一个。
APP_VIDEO_CODEC=avc1

# ---- 权重与训练产物定位 ----
# 1) 显式指定权重（优先级最高）。训练产物不在标准位置时用它兜底。
# APP_WEIGHTS=C:/yolo_runs/train/visdrone_v4/weights/best.pt
#
# 2) 否则按「run 名（外层）× 根目录（内层）」探测 <根>/<run名>/weights/best.pt，
#    取第一个存在的文件。多个值用逗号或分号分隔。
APP_RUNS_DIRS=C:/yolo_runs/train;./runs/train
APP_RUN_NAMES=visdrone_v4,visdrone_v3,visdrone_v2,visdrone_v1
# 兜底 run（冒烟/自检产物）：仅当上面全部缺失时才使用，避免玩具模型顶掉真实权重
APP_FALLBACK_RUN_NAMES=smoke_v4,smoke_v4-2,gpu_check

# ---- 训练指标接口（/api/v1/metrics，前端「设置 → 训练成果」）----
APP_METRICS_ENABLED=true
# 消融对比文件名（相对 run 目录的上一级）
APP_METRICS_COMPARE_GLOB=对比_*.txt
